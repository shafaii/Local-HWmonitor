<Page
    x:Class="PcSentinel.App.Views.HardwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:PcSentinel.Core.Models"
    xmlns:vm="using:PcSentinel.App.ViewModels"
    mc:Ignorable="d">

    <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Pane: Hardware Devices Explorer -->
        <Border Grid.Column="0" Background="#202020" CornerRadius="8" Padding="16" BorderBrush="#333333" BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="Hardware Devices" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                <TextBlock Text="Select a physical component to inspect sensors:" FontSize="12" Foreground="#8A8886" />

                <ListView
                    ItemsSource="{x:Bind ViewModel.HardwareTree, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedHardware, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:HardwareItem">
                            <StackPanel Padding="8,6" Spacing="4">
                                <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Type}" FontSize="11" Foreground="#0078D4" />
                                    <TextBlock Text="•" FontSize="11" Foreground="#555555" />
                                    <TextBlock Text="{x:Bind Sensors.Count}" FontSize="11" Foreground="#8A8886" />
                                    <TextBlock Text="sensors" FontSize="11" Foreground="#8A8886" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Right Pane: Selected Device Detail & Sensors -->
        <Border Grid.Column="1" Background="#202020" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1">
            <StackPanel Spacing="16">
                <Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.SelectedHardware.Name, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedHardware.Id, Mode=OneWay}" FontSize="11" Foreground="#8A8886" />
                    </StackPanel>

                    <TextBox
                        HorizontalAlignment="Right"
                        Width="220"
                        PlaceholderText="Filter sensors..."
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <ListView ItemsSource="{x:Bind ViewModel.SelectedHardwareSensors, Mode=OneWay}" SelectionMode="None">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" Background="#282828" BorderBrush="#383838" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SENSOR ID / NAME" FontSize="11" FontWeight="SemiBold" Foreground="#8A8886" />
                                <TextBlock Grid.Column="1" Text="CURRENT" FontSize="11" FontWeight="SemiBold" Foreground="#8A8886" />
                                <TextBlock Grid.Column="2" Text="METRIC TYPE" FontSize="11" FontWeight="SemiBold" Foreground="#8A8886" />
                                <TextBlock Grid.Column="3" Text="RECORDED MIN" FontSize="11" FontWeight="SemiBold" Foreground="#8A8886" />
                                <TextBlock Grid.Column="4" Text="RECORDED MAX" FontSize="11" FontWeight="SemiBold" Foreground="#8A8886" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SensorViewModel">
                            <Grid Padding="12,8" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SensorName}" FontSize="13" FontWeight="Medium" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Bind SensorId}" FontSize="10" Foreground="#666666" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{x:Bind FormattedValue}" FontSize="14" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SensorType}" FontSize="12" Foreground="#9E9E9E" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedMin}" FontSize="12" Foreground="#7A7876" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind FormattedMax}" FontSize="12" Foreground="#7A7876" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</Page>
