<Page
    x:Class="PcSentinel.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
        <Border Background="#202020" CornerRadius="8" Padding="32" BorderBrush="#333333" BorderThickness="1">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <FontIcon x:Name="PageIcon" Glyph="&#xE946;" FontSize="48" Foreground="#0078D4" HorizontalAlignment="Center" />
                <TextBlock x:Name="PageTitle" Text="Section Title" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                <TextBlock x:Name="PageDescription" Text="Detailed description of the upcoming capability." FontSize="13" Foreground="#8A8886" TextWrapping="Wrap" TextAlignment="Center" />
                <Border Background="#292929" CornerRadius="4" Padding="12,8" Margin="0,8,0,0">
                    <TextBlock x:Name="PageMilestone" Text="Milestone in progress according to Architecture Roadmap." FontSize="11" Foreground="#107C41" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>
