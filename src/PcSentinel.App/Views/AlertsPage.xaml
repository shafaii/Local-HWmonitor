<Page
    x:Class="PcSentinel.App.Views.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PcSentinel.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="0,0,16,24">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" FontSize="13" Foreground="#9E9E9E" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.RefreshListCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Refresh" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearObservationsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock Text="Clear Log" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Observation Status Banner -->
            <Border Background="#202020" CornerRadius="8" Padding="16" BorderBrush="#333333" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="DETERMINISTIC OBSERVATION STATUS" FontSize="11" FontWeight="Bold" Foreground="#8A8886" />
                        <TextBlock Text="{x:Bind ViewModel.StatusSummary, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Active Conditions:" FontSize="12" Foreground="#8A8886" />
                        <TextBlock Text="{x:Bind ViewModel.ObservationCount, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#0078D4" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Observation Items List -->
            <Border Background="#1C1C1C" CornerRadius="8" Padding="16" BorderBrush="#333333" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Telemetry Observations Stream" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />

                    <ListView ItemsSource="{x:Bind ViewModel.Observations, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252526" CornerRadius="6" Padding="12,10" Margin="0,4" BorderBrush="#333337" BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Severity Icon -->
                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="&#xE7BA;"
                                            FontSize="16"
                                            Foreground="#D83B01"
                                            VerticalAlignment="Center" />

                                        <!-- Message & Details -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Message}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="{Binding DeviceId}" FontSize="11" Foreground="#8A8886" />
                                                <TextBlock Text="•" FontSize="11" Foreground="#555555" />
                                                <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="Medium" Foreground="#FFB900" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Timestamp -->
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding Timestamp, ConverterParameter='HH:mm:ss'}"
                                            FontSize="11"
                                            Foreground="#666666"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
